# Copy to .env and fill in every value. Never commit .env.

# Public hostname of this Posta instance. Its DNS A record must point to the
# VPS before the first start, so Caddy can obtain the HTTPS certificate.
POSTA_DOMAIN=posta.example.com

# First admin account (created on first start only).
POSTA_ADMIN_EMAIL=you@example.com
# At least 12 characters.
POSTA_ADMIN_PASSWORD=

# Generate each of these with: openssl rand -hex 32
POSTA_JWT_SECRET=
POSTA_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
